        "route_number": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Route Number",
          "type": "string"
        },
        "km_m": {
          "title": "Km M",
          "type": "number"
        },
        "method": {
          "const": "MANUAL_READING",
          "default": "MANUAL_READING",
