          "default": null,
          "title": "Captured At"
        },
        "method": {
          "default": "MAP",
          "enum": [
            "MAP",
            "GPS"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "lon",
        "lat"
      ],
      "title": "Position",
      "type": "object"
    }
