        "axis_version": {
          "minimum": 1,
          "title": "Axis Version",
          "type": "integer"
        },
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "segment_version": {
          "minimum": 1,
          "title": "Segment Version",
          "type": "integer"
        },
        "station_m": {
          "title": "Station M",
          "type": "number"
