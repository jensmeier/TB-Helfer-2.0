      "title": "NetworkObject",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "base_version": {
          "minimum": 0,
          "title": "Base Version",
          "type": "integer"
        },
        "entity_type": {
          "const": "NODE",
          "default": "NODE",
