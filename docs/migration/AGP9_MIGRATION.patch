diff -ruN /mnt/data/APP_high_impact_all/build.gradle.kts /mnt/data/APP_AGP9/build.gradle.kts
--- /mnt/data/APP_high_impact_all/build.gradle.kts	2026-01-30 11:24:20.313031219 +0000
+++ /mnt/data/APP_AGP9/build.gradle.kts	2026-01-30 11:40:32.347785836 +0000
@@ -1,6 +1,12 @@
 plugins {
-    id("com.android.application") version "8.13.2" apply false
+    // AGP 9.0.0 (Jan 2026): benötigt Gradle 9.1.0+ und unterstützt bis API 36.
+    // Siehe: Android Gradle plugin 9.0.0 Release Notes (Compatibility).
+    id("com.android.application") version "9.0.0" apply false
+
+    // Wir bleiben (vorerst) beim externen Kotlin-Plugin, weil KSP/Room aktuell noch
+    // nicht sauber mit AGP "built‑in Kotlin" zusammen spielt. (Opt‑Out in gradle.properties)
     id("org.jetbrains.kotlin.android") version "2.3.0" apply false
-    // KSP-Version: seit 2.3.x nicht mehr strikt an die Kotlin-Compiler-Version gekoppelt, aber sollte kompatibel sein.
-    id("com.google.devtools.ksp") version "2.3.4" apply false
+
+    // KSP2 ist Pflicht für Kotlin 2.3+ und AGP 9+.
+    id("com.google.devtools.ksp") version "2.3.5" apply false
 }
