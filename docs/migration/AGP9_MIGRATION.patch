diff -ruN /mnt/data/APP_high_impact_all/gradle.properties /mnt/data/APP_AGP9/gradle.properties
--- /mnt/data/APP_high_impact_all/gradle.properties	2026-01-30 11:17:11.231052994 +0000
+++ /mnt/data/APP_AGP9/gradle.properties	2026-01-30 11:40:55.259113984 +0000
@@ -21,3 +21,16 @@
 # org.gradle.configuration-cache=true
 android.useAndroidX=true
 android.enableJetifier=true
+
+# -----------------------------------------------------------------------------
+# AGP 9.x (Jan 2026): "built-in Kotlin" ist standardmäßig aktiv und kollidiert
+# aktuell mit KSP (Room). Deshalb opt-out, bis KSP/Room (oder dein Projekt)
+# vollständig auf built-in Kotlin migriert ist.
+#
+# Wenn du später built-in Kotlin aktivieren willst:
+#  - diese beiden Properties entfernen
+#  - `org.jetbrains.kotlin.android` Plugin aus build.gradle(.kts) entfernen
+#  - KSP/Room-Setup prüfen
+# -----------------------------------------------------------------------------
+android.builtInKotlin=false
+android.newDsl=false
