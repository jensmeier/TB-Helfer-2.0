 # org.gradle.configuration-cache=true
 android.useAndroidX=true
 android.enableJetifier=true
+
+# AGP 9.x: Die neue DSL ist standardmäßig aktiv. Solange du nicht alle Plugins/Build-Logik
+# angepasst hast, ist es deutlich stabiler, vorerst auf die alte DSL zu opt-outen.
+# (Kann später wieder entfernt werden, wenn alles kompatibel ist.)
+android.newDsl=false
+
+# AGP 9.x bringt "built-in Kotlin" (Runtime-Dependency auf Kotlin Gradle Plugin) mit.
+# Wenn du die Kotlin/KSP Versionen explizit steuerst, ist es oft stabiler, built-in Kotlin auszuschalten.
+android.builtInKotlin=false
