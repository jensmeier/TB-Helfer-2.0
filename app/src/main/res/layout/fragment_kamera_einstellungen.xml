<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kamera / Foto"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="?attr/colorOnBackground"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bildqualität"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/rgQualitaet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbQualNiedrig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Niedrig"
                android:textColor="?attr/colorOnBackground" />

            <RadioButton
                android:id="@+id/rbQualMittel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mittel"
                android:textColor="?attr/colorOnBackground" />

            <RadioButton
                android:id="@+id/rbQualHoch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoch"
                android:textColor="?attr/colorOnBackground" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:text="Blitz AUS / AUTO / AN, Nachtmodus und Zoom werden direkt unten in der Kamera bedient. Der Zwei-Finger-Zoom bleibt aktiv; Doppeltipp setzt auf 1,0x zurück."
            android:textColor="?attr/colorOnBackground" />

    </LinearLayout>
</ScrollView>
