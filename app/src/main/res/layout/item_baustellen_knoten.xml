<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgIndent"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right_24"
                android:contentDescription="@null"
                android:layout_marginEnd="6dp"
                android:alpha="0.55"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtTitel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_item_baustellen_knoten_text_1"
                style="@style/TextAppearance.TBHelfer.Body"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtAktuell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_item_baustelle_text_2"
                style="@style/TextAppearance.TBHelfer.Caption"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_drop_down_24"
                android:contentDescription="@string/ui_cd_expand" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_item_baustellen_knoten_text_2"
            style="@style/TextAppearance.TBHelfer.Caption"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.75"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipUnter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Unter: 0"
                    style="@style/TextAppearance.TBHelfer.Caption"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipGesamt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Gesamt: 0"
                    style="@style/TextAppearance.TBHelfer.Caption"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/chipBilder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Bilder: 0"
                    style="@style/TextAppearance.TBHelfer.Caption"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipBtb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="BTB: 0"
                    style="@style/TextAppearance.TBHelfer.Caption"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMaengelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="Mängel"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipMangelOffen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Offen 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipMangelArbeit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Arbeit 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipMangelErledigt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Erled. 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipMangelAbgelehnt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Abgel. 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAbnahmeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="Abnahmen"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAbnahmeJa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Ja 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipAbnahmeNein"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Nein 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chipAbnahmePruefung"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1.35"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Prüfung 0"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
