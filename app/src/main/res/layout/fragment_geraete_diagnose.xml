<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Geräte-Diagnose"
            android:textColor="?attr/colorOnBackground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Liest echte Kamera- und GNSS-Fähigkeiten des Handys aus. Vermessungs- und BTB-Daten werden nicht verändert."
            android:textColor="?attr/colorOnBackground"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnoseNeuLaden"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Diagnose neu laden" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Gerät"
            android:textColor="?attr/colorOnBackground"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDiagnoseGeraet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="?attr/colorOnBackground"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Kameras"
            android:textColor="?attr/colorOnBackground"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDiagnoseKameras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="?attr/colorOnBackground"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnoseBlitzTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Blitz 2 s testen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnoseKameraTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Kamera-Test öffnen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="GPS / GNSS"
            android:textColor="?attr/colorOnBackground"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDiagnoseGnss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="?attr/colorOnBackground"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnoseGnssLive"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="GNSS live starten" />

    </LinearLayout>
</ScrollView>
