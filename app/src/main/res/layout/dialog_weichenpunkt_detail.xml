<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtWeicheDetailKontext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weiche"
            android:textStyle="bold" />


        <LinearLayout
            android:id="@+id/layoutWeicheTypwahl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWeicheTypWa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WA" />

            <Button
                android:id="@+id/btnWeicheTypWe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="WE" />

            <Button
                android:id="@+id/btnWeicheTypWez"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="WEZ" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtWeicheKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="km"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtWeicheNotiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notiz (optional)"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:id="@+id/txtWeicheGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Noch kein GPS gespeichert" />

        <Button
            android:id="@+id/btnWeicheGpsUebernehmen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GPS übernehmen" />

    </LinearLayout>
</ScrollView>
