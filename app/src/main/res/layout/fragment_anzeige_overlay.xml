<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anzeige &amp; Overlay"
            android:textColor="?attr/colorOnBackground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="Darstellung der App und Informationen auf Kamerafotos."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnzeigeApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="App-Anzeige"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Hell/Dunkel/System und Anzahl der Suchspalten."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnzeigeOverlayDetails"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="Kamera-Overlay"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Inhalte, Position, Schriftgröße, Transparenz und automatische Lesbarkeit."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.75" />

    </LinearLayout>
</ScrollView>
