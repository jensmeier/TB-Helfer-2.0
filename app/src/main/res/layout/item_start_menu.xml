<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ui_item_start_menu_text_1"
        android:textAllCaps="false"
        android:gravity="center"
        android:singleLine="false"
        android:maxLines="2"
        android:includeFontPadding="false"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeMaxTextSize="20sp"
        app:autoSizeStepGranularity="1sp"
        android:background="@drawable/bg_menu_button_round"
        android:textColor="@android:color/white" />

</FrameLayout>
