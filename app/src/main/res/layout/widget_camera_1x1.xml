<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCameraRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@color/widget_bg">

    <ImageView
        android:id="@+id/widgetCameraIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_camera_widget"
        android:contentDescription="@string/ui_widget_camera_1x1_contentdescription_1"/>
</FrameLayout>
