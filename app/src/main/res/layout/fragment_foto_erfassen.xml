<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollFotoErfassen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:animateLayoutChanges="true">

        <TextView
            android:id="@+id/txtHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_fragment_foto_erfassen_text_1"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="?attr/colorOnBackground" />

        <ImageView
            android:id="@+id/imgVorschau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:maxHeight="340dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/foto" />

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtDatumZeit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorOnBackground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtWarnKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorError"
            style="@style/TextAppearance.TBHelfer.Body"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_fragment_foto_erfassen_text_2"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground" />

        <EditText
            android:id="@+id/edtKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ui_fragment_foto_erfassen_hint_3"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/txtGvpMastLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="GVP / Mast"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edtGvpMastValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="GVP / Mast"
            android:inputType="textCapSentences"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtApKorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="AP / KOR"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edtApKorValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AP / KOR"
            android:inputType="textCapSentences"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_fragment_foto_erfassen_text_4"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground" />

        <AutoCompleteTextView
            android:id="@+id/actFirma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ui_fragment_foto_erfassen_hint_5"
            android:inputType="textCapWords" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_fragment_foto_erfassen_text_6"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground" />

        <Spinner
            android:id="@+id/spBildtyp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/layoutObjektBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bereich"
                android:textStyle="bold"
                android:textColor="?attr/colorOnBackground" />

            <Spinner
                android:id="@+id/spObjektBereich"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_fragment_foto_erfassen_text_7"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground" />

        <AutoCompleteTextView
            android:id="@+id/actKurztext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ui_fragment_foto_erfassen_hint_8"
            android:inputType="textCapSentences"
            android:maxLength="80" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Langtext / BTB-Text (optional)"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground" />

        <EditText
            android:id="@+id/edtNotiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Ausführlicher Text für das Bautagebuch"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbbrechen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suche_auswahl_abbrechen"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeichern"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/ui_fragment_baustelle_neu_text_18"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
