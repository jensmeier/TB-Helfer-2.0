<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_fragment_foto_liste_text_1"
        style="@style/TextAppearance.TBHelfer.Title"
        android:textColor="?attr/colorOnBackground"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/textLeer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleText"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/ui_fragment_foto_liste_text_2"
        android:textColor="?attr/colorOnBackground"
        style="@style/TextAppearance.TBHelfer.Body" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFotos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/textLeer"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- FOOTER -->
    <include
        android:id="@+id/footer"
        layout="@layout/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true" />

</RelativeLayout>
