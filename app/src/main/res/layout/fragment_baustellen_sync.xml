<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collab_title"
            android:textColor="?attr/colorOnSurface"
            style="@style/TextAppearance.TBHelfer.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/collab_intro"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.76"
            style="@style/TextAppearance.TBHelfer.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressBaustellenSync"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtBaustellenSyncStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/collab_local_loading"
                android:textColor="?attr/colorOnSurface"
                style="@style/TextAppearance.TBHelfer.Body" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBaustellenSyncRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/collab_sync_now"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/collab_binding_explanation"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.8"
            style="@style/TextAppearance.TBHelfer.Body" />

        <LinearLayout
            android:id="@+id/containerBaustellenSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="?attr/colorSurface" />

    </LinearLayout>
</ScrollView>
