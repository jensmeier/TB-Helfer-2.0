<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:hint="@string/ui_item_firma_row_hint_1">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/acAnzahl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true"
            android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>

    <Space
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/ui_dialog_neuer_streckenpunkt_hint_2">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/acBez"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/btnRemoveRow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/ui_item_firma_row_contentdescription_2"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</LinearLayout>
