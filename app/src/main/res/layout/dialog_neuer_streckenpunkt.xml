<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtPunktKontext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kontext"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="km"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtNotiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notiz (optional)"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:id="@+id/txtGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Noch kein GPS gespeichert" />

        <Button
            android:id="@+id/btnGpsUebernehmen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GPS übernehmen" />

    </LinearLayout>
</ScrollView>
