<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <!-- Menü-Container: dynamische Breite (88% vom Screen), max ~360dp -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="34dp"
        android:paddingBottom="26dp"
        android:background="?attr/colorSurface"
        app:layout_constraintWidth_percent="0.88"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titel -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_fragment_startmenue_text_1"
            style="@style/TextAppearance.TBHelfer.Title"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:paddingBottom="18dp" />

        <!-- Menü-Liste -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMenu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"
            android:overScrollMode="never" />

        <!-- Mehr Abstand vor Einstellungen (höher setzen) -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- Einstellungen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingsShortcut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ui_fragment_einstellungen_text_1"
            android:textAllCaps="false"
            android:gravity="center"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeStepGranularity="1sp"
            android:background="@drawable/bg_menu_button_round"
            android:textColor="@android:color/white" />

        <!-- Footer Name -->
        <TextView
    android:id="@+id/footerName"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:text="@string/ui_fragment_startmenue_text_2"
    style="@style/TextAppearance.TBHelfer.Caption"
    android:textColor="?attr/colorOnSurface"
    android:alpha="0.85"
    android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

