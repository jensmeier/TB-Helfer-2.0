<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_fragment_aktuelle_baustelle_text_1"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="?attr/colorOnBackground"
        android:paddingBottom="12dp"/>

    <TextView
        android:id="@+id/txtAktuelleBaustelle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_fragment_aktuelle_baustelle_text_2"
        android:textSize="16sp"
        android:textColor="?attr/colorOnBackground"
        android:paddingBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZurBaustellenliste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_fragment_aktuelle_baustelle_text_3"
        android:textAllCaps="false"
        android:layout_marginBottom="18dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZurueck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_fragment_aktuelle_baustelle_text_4"
        android:textAllCaps="false"/>

</LinearLayout>
