<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Streckendaten"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="?attr/colorOnBackground"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vermessungsdaten importieren, prüfen und einfach bearbeiten"
            android:textSize="13sp"
            android:textColor="?attr/colorOnBackground"
            android:paddingBottom="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStreckendatenZip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Streckendaten importieren"
            android:textAllCaps="false" />

        <LinearLayout
            android:id="@+id/layoutBerechnungsFortschritt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/bg_card"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBerechnung"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtBerechnungsFortschritt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Berechnung wird vorbereitet …"
                android:textColor="?attr/colorOnBackground"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrafischePruefung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Grafische Übersicht"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStreckenGleiseBearbeiten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Strecken / Gleise / Weichen bearbeiten"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVermessungsdatenLoeschen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="4. Vermessungsdaten löschen"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Interner Status bleibt fuer Import-/Fehlermeldungen vorhanden, aber nicht mehr im Hauptmenue sichtbar. -->
        <TextView
            android:id="@+id/txtVermessungsdatenStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
