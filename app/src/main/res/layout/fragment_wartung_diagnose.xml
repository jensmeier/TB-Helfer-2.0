<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wartung &amp; Diagnose"
            android:textColor="?attr/colorOnBackground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="Geräteprüfung, Speicherpflege und App-Aktualisierung."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWartungGeraeteDiagnose"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Geräte-Diagnose"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kameras, Blitz, Zoom, Nachtmodus und GNSS-Fähigkeiten des Handys prüfen."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWartungSpeicherBereinigen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Fotospeicher prüfen"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:id="@+id/txtWartungSpeicherStatus"
            android:text="Prüft fehlende Dateien und unklare Fotozuordnungen. Löscht und verschiebt keine Daten."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWartungNachUpdates"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Nach Updates suchen"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtWartungUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorOnBackground"
            android:textStyle="bold"
            android:text="Aktuell: TB-Helfer" />

        <TextView
            android:id="@+id/txtWartungUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.85"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWartungUpdateInstallieren"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Aktualisieren"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Neue Versionen und die Hinweise zu Verbesserungen/Änderungen kommen direkt vom TB-Server. Ein normales App-Update behält Gerätebindung und lokale Daten."
            android:textColor="?attr/colorOnBackground"
            android:alpha="0.75" />


    </LinearLayout>
</ScrollView>

