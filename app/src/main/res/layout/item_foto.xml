<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="?attr/colorSurface">

    <ImageView
        android:id="@+id/imgVorschau"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/foto"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/textDateiname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_item_foto_text_1"
            android:textColor="?attr/colorOnSurface"
            style="@style/TextAppearance.TBHelfer.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDatum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_dialog_schicht_text_1"
            android:textColor="?attr/colorOnSurface"
            style="@style/TextAppearance.TBHelfer.Caption" />

    </LinearLayout>

</LinearLayout>
