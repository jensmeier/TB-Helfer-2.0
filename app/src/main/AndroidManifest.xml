<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".TBHelferApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:theme="@style/Theme.TBHelfer">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".ui.activation.AktivierungActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tbhelfer" android:host="activate" />
                <data android:scheme="tbhelfer" android:host="invite" />
                <data android:scheme="tbhelfer" android:host="worksite-invite" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HauptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".ui.bautagebuch.BtbPdfViewerActivity"
            android:exported="false" />

        <activity android:name=".server.recovery.RecoveryActivity" android:exported="false" />
        <activity android:name=".server.recovery.RecoveryRestartActivity" android:exported="false"
            android:process=":tb_recovery_restart" android:excludeFromRecents="true" />

        <!-- Damit wir Fotos aus dem App-Ordner sicher öffnen/teilen können -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateianbieter"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dateipfade" />
        </provider>

        <service android:name=".speech.SpeechWidgetService" android:exported="false" android:foregroundServiceType="microphone" android:stopWithTask="true" />
        <activity android:name=".speech.SpeechWidgetActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="de.tbhelfer.speechwidget" />
        <activity android:name=".speech.SpeechCaptureActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <receiver android:name=".speech.SpeechWidgetProvider" android:exported="false" android:label="@string/speech_widget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/speech_widget_info" />
        </receiver>

        <!-- Widget-Konfiguration durch den Android-Launcher -->
        <activity
            android:name=".widget.TBHelferWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.TBHelfer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.CameraWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.TBHelfer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.TBHelferWidgetSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TBHelfer" />

        <receiver
            android:name=".widget.CameraWidgetProvider"
            android:label="TB-Helfer Kamera"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/camera_widget_1x1_info" />
        </receiver>

        <receiver
            android:name=".widget.CurrentSiteWidgetProvider"
            android:label="TB-Helfer Baustelle"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/current_site_widget_2x2_info" />
        </receiver>

    </application>

</manifest>


