# TB-Helfer: einheitliche Zeilenenden im Repository.
# Quellcode und Textdateien bleiben LF, Windows-Batchdateien bewusst CRLF.

* text=auto

*.kt         text eol=lf
*.kts        text eol=lf
*.java       text eol=lf
*.xml        text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.toml       text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.sql        text eol=lf
*.py         text eol=lf
*.ps1        text eol=lf
*.sh         text eol=lf

*.bat        text eol=crlf
*.cmd        text eol=crlf

*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.jar        binary
*.apk        binary
